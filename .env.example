# Upstream OpenAI-compatible base URL, without the trailing slash if possible.
REAL_BASE=https://your-upstream.example.com/v1

# Comma-separated model ids exposed by GET /v1/models.
PROXY_MODELS=gpt-4o-mini,gpt-4.1-mini

# Force stream=true for POST /v1/chat/completions.
FORCE_CHAT_STREAM=true

# HTTP timeout in seconds when proxying to the upstream.
PROXY_TIMEOUT=120

# Optional app title for the root endpoint.
PROXY_TITLE=OpenAI-Compatible API Proxy
